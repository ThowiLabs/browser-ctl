{
  "name": "browser-ctl",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:extension": "pnpm --filter @browsermcp/extension build",
    "build:cli": "go build -trimpath -ldflags \"-s -w\" -o bin/browser-ctl ./cmd/browser-ctl",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
